{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "together-album",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // 每个分享会话一个 Durable Object，用 SQLite 存储（免费计划可用）
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "SessionRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionRoom"] }],
  // public/ 是静态资源；首页、加入页和接口先经过 Worker
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/v/*", "/api/*", "/healthz"]
  },
  "routes": [{ "pattern": "album.example.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
